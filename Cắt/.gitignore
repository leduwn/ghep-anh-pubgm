# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db
*.tmp
*.temp
temp_inspect/

# Ảnh đầu vào & đầu ra (Giữ khung thư mục, bỏ qua dữ liệu bên trong)
input/*
!input/.gitkeep
output/*
!output/.gitkeep
**/input/*
!**/input/.gitkeep
**/output/*
!**/output/.gitkeep

# File ảnh & nén
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.bmp
*.webp
*.zip

